{
  "name": "palm-analysis",
  "main": "cloudflare/worker.mjs",
  "account_id": "ac0d5d4f0aa890b2887eca486904bd3f",
  "compatibility_date": "2026-10-11",
  "workers_dev": true,
  "assets": {
    "directory": "src/palm_backend/web",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "PALM_ENVIRONMENT": "demo",
    "PALM_API_ENABLED": "true",
    "PALM_SUPABASE_PROJECT_REF": "pyugqoogcoynvywihgym"
  },
  "triggers": {"crons": ["*/15 * * * *"]},
  "observability": {"enabled": false},
  "env": {
    "development": {
      "name": "palm-analysis-development",
      "workers_dev": true,
      "vars": {
        "PALM_ENVIRONMENT": "development", "PALM_API_ENABLED": "true", "PALM_AUTH_MODE": "public_booth",
        "PALM_RUNTIME_READY": "true", "PALM_SUPABASE_PROJECT_REF": "ihkbmxwidahgbrvxmrrk",
        "PALM_BOOTH_ID": "11111111-1111-4111-8111-111111111111"
      },
      "triggers": {"crons": []}
    },
    "staging": {
      "name": "palm-analysis-staging",
      "workers_dev": false,
      "vars": {"PALM_ENVIRONMENT": "staging", "PALM_API_ENABLED": "false", "PALM_AUTH_MODE": "supabase"},
      "triggers": {"crons": []}
    },
    "production": {
      "name": "palm-analysis-production",
      "workers_dev": false,
      "vars": {"PALM_ENVIRONMENT": "production", "PALM_API_ENABLED": "false", "PALM_AUTH_MODE": "supabase"},
      "triggers": {"crons": []}
    }
  }
}
