# Local single-process booth backend. Generate a long random key before running.
PALM_OPERATOR_KEY=
PALM_DATABASE_PATH=data/palm.sqlite3
PALM_ANALYSIS_MODE=demo
# Visitor start without login; config writes still require the private operator key.
PALM_PUBLIC_SESSIONS=false
PALM_PUBLIC_STARTS_PER_MINUTE=6
PALM_SESSION_TTL_SECONDS=3600
PALM_ANALYSIS_TIMEOUT_SECONDS=45
PALM_MAX_UPLOAD_BYTES=5242880
PALM_MAX_ACTIVE_ANALYSES=2
PALM_MAX_SESSIONS=500
# Exact frontend origins, JSON array. Empty means no cross-origin browser access.
PALM_CORS_ORIGINS=[]

# Only used when PALM_ANALYSIS_MODE=claude.
# Photos leave the device only after external_processing_consent=true.
PALM_ANTHROPIC_API_KEY=
PALM_ANTHROPIC_MODEL=claude-opus-5-5

# Existing VM OCX route. Inject the key into the server process only.
# Use an explicitly verified origin; no implicit fallback to a local OCX.
PALM_OCX_BASE_URL=
PALM_OCX_API_KEY=
PALM_OCX_MODEL=gpt-6.1-sol
